---
import Layout from "../layouts/Layout.astro";
import Hud from "../components/Hud.astro";
import JourneySection from "../components/JourneySection.astro";
import rawMilestones from "../data/milestones.json";
import encountersByMilestone from "../data/encounters.json";
import { sectionHeightsVh, sortedMilestones, toVisualPosition, type Milestone } from "../lib/journey";
import { colorAt } from "../lib/palette";

const milestones = sortedMilestones(rawMilestones as Milestone[]);
const heights = sectionHeightsVh(milestones);
const totalHeightVh = heights.reduce((sum, height) => sum + height, 0);

// One boundary colour per milestone plus one final boundary past the Moon —
// each section's top matches the previous section's bottom, so the sky-to-space
// gradient reads as continuous rather than as fifteen separate backgrounds.
const boundaries = [
  ...milestones.map((milestone) => toVisualPosition(milestone.distanceKm)),
  1,
];

// Giving every `.stop` its own gradient (even a densely-sampled one) still
// meant fifteen separate boxes, each an independent rendering surface — so a
// hard edge could show at the seam between two of them regardless of how
// closely their colours matched there. The fix is architectural, not
// numerical: one gradient, painted once, behind the whole journey (see
// `.journey-sky` in global.css), so there are no box edges for a seam to
// live on in the first place.
//
// `sectionHeightsVh` clamps short legs up to MIN_LEG_VH, so vh and `position`
// are not proportional across the page — a section can occupy far more (or
// less) screen height than its raw distance delta would suggest. Placing
// colour stops at even `position` fractions would therefore misalign the
// palette against where milestones actually land on screen. Cumulative
// height fractions fix that: stop i sits at (sum of the heights of all
// sections before it) / (total height), which is exactly where that
// milestone's boundary really renders.
const cumulativeHeightFractions = heights.reduce<number[]>(
  (acc, height) => [...acc, acc[acc.length - 1] + height / totalHeightVh],
  [0],
);

const SKY_GRADIENT_SAMPLES_PER_SECTION = 8;

function journeySkyGradient(): string {
  const stops = milestones.flatMap((_, index) =>
    Array.from({ length: SKY_GRADIENT_SAMPLES_PER_SECTION }, (_, sample) => {
      const t = sample / SKY_GRADIENT_SAMPLES_PER_SECTION;
      const position = boundaries[index] + (boundaries[index + 1] - boundaries[index]) * t;
      const heightFraction =
        cumulativeHeightFractions[index] +
        (cumulativeHeightFractions[index + 1] - cumulativeHeightFractions[index]) * t;
      return `${colorAt(position)} ${(heightFraction * 100).toFixed(3)}%`;
    }),
  );
  stops.push(`${colorAt(1)} 100%`);
  // Earth (position 0) is the bottom-most section on the page and the Moon
  // (position 1) the topmost (see the reversed display order below), so the
  // gradient runs bottom-to-top with the same direction as the page itself.
  return `linear-gradient(to top, ${stops.join(", ")})`;
}

const encountersFor = encountersByMilestone as Record<string, { kind: string; label: string }[]>;

// The journey is an ascent, not a descent: Earth renders at the BOTTOM of the
// page and the Moon at the TOP, so scrolling up is travelling further from
// Earth. `milestones`/`heights`/`boundaries` above stay in ascending-distance
// order — that's still the source of truth the maths reads from — this
// reversed copy only controls the order sections stack on the page. Each
// section keeps its own height; only the stacking direction flips.
const displayMilestones = [...milestones].reverse();
---

<Layout title="Deep Space: Earth to Moon">
  <header>
    <nav aria-label="Primary">
      <a href="./">Deep Space</a>
    </nav>
  </header>
  <Hud />
  <main id="journey">
    <div class="journey-sky" aria-hidden="true" style={`background:${journeySkyGradient()}`} />
    {
      displayMilestones.map((milestone, displayIndex) => {
        const index = milestones.length - 1 - displayIndex;
        return (
          <JourneySection
            milestone={milestone}
            encounters={encountersFor[milestone.id] ?? []}
            heightVh={heights[index]}
            isFirst={milestone.id === "earth"}
          />
        );
      })
    }
  </main>
  <script is:inline>
    // The journey starts at Earth even though it's the last section in the
    // page (Moon renders at the top — see the reversed order above). This
    // sets the initial view via the browser's own fragment-navigation, the
    // same native mechanism an <a href="#earth"> link would use — not
    // scrollTo/scrollIntoView, and not a listener that could later intercept
    // scrolling. Guarded so an explicit deep link (e.g. #moon) is respected
    // instead of overridden.
    if (!location.hash) {
      location.replace(location.pathname + location.search + "#earth");
    }
  </script>
  <script src="../scripts/journey-client.ts"></script>
</Layout>
