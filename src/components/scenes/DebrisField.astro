---
// A field of orbital clutter, not a diagram: many small irregular fragments
// at deliberately varied size/opacity (larger + brighter reads as "closer")
// plus two faint dashed arcs for orbital context. Coordinates are hand-placed
// and fixed, not Math.random, so the layout never shifts between builds.
const jaggedPoints = "-1,-0.6 0.8,-1 1,0.4 0.3,1 -0.9,0.6";
const panelPoints = "-1,-0.5 1,-0.6 0.9,0.5 -0.8,0.6";

const fragments = [
  { x: 8, y: 16, size: 8.5, rot: 12, opacity: 0.92, shape: "panel" },
  { x: 26, y: 42, size: 3.2, rot: 50, opacity: 0.45, shape: "jag" },
  { x: 16, y: 68, size: 5, rot: -20, opacity: 0.6, shape: "jag" },
  { x: 38, y: 22, size: 2.4, rot: 80, opacity: 0.32, shape: "jag" },
  { x: 46, y: 55, size: 6.4, rot: 30, opacity: 0.78, shape: "panel" },
  { x: 60, y: 12, size: 3, rot: -45, opacity: 0.38, shape: "jag" },
  { x: 66, y: 36, size: 8, rot: 8, opacity: 0.95, shape: "panel" },
  { x: 74, y: 70, size: 2.6, rot: 60, opacity: 0.32, shape: "jag" },
  { x: 82, y: 20, size: 4, rot: -30, opacity: 0.55, shape: "jag" },
  { x: 88, y: 46, size: 5.6, rot: 15, opacity: 0.72, shape: "panel" },
  { x: 4, y: 84, size: 3.4, rot: 40, opacity: 0.42, shape: "jag" },
  { x: 94, y: 78, size: 2.4, rot: -60, opacity: 0.3, shape: "jag" },
  { x: 54, y: 84, size: 4.2, rot: 22, opacity: 0.5, shape: "jag" },
  { x: 30, y: 90, size: 5.8, rot: -12, opacity: 0.68, shape: "panel" },
  { x: 78, y: 6, size: 2.2, rot: 70, opacity: 0.26, shape: "jag" },
  { x: 13, y: 30, size: 2, rot: 100, opacity: 0.28, shape: "jag" },
];
---

<div class="debris-field" aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none">
    <path
      class="debris-arc"
      d="M-10 30 Q50 5 110 30"
      fill="none"
    />
    <path
      class="debris-arc"
      d="M-10 75 Q50 95 110 75"
      fill="none"
    />
    {
      fragments.map((f) => (
        <g transform={`translate(${f.x} ${f.y}) rotate(${f.rot}) scale(${f.size})`} opacity={f.opacity}>
          <polygon points={f.shape === "panel" ? panelPoints : jaggedPoints} />
        </g>
      ))
    }
  </svg>
</div>
