---
// Shared ascent scene for the three lower-atmosphere milestones —
// troposphere, stratosphere, mesosphere — so the climb reads as one
// continuous recession of Earth's limb rather than three unrelated scenes.
// Same curved-limb technique as OrbitHorizon/KarmanHorizon (a filled path
// plus a stroked rim along the same curve), but parameterised per stage:
// the limb recedes and the atmosphere thins with altitude, and the
// mesosphere stage's colours are tuned to hand off directly into
// KarmanHorizon's existing palette (`#123a5e` -> near-black) so the step
// into the Kármán scene doesn't read as a sudden colour jump.
type Stage = "troposphere" | "stratosphere" | "mesosphere";
type CloudShape = "puff" | "wisp";

export interface Props {
  stage: Stage;
}

const { stage } = Astro.props;

const cloudBlobs: Record<CloudShape, string> = {
  puff: "M -1.1 0.1 C -1.2 -0.35 -0.7 -0.55 -0.3 -0.4 C -0.05 -0.6 0.35 -0.55 0.5 -0.3 C 0.85 -0.4 1.15 -0.15 1.05 0.15 C 0.9 0.4 0.5 0.5 0.15 0.42 C -0.3 0.55 -0.9 0.45 -1.1 0.1 Z",
  wisp: "M -1 0 C -1 -0.16 -0.6 -0.22 -0.2 -0.15 C 0.2 -0.22 0.7 -0.12 1 0 C 0.7 0.16 0.2 0.2 -0.2 0.15 C -0.6 0.2 -1 0.12 -1 0 Z",
};

interface Cloud {
  x: number;
  y: number;
  sx: number;
  sy: number;
  opacity: number;
  shape: CloudShape;
  layer: "near" | "far";
}

interface StageConfig {
  apex: number;
  dip: number;
  // The last two stops always repeat the stage's own final colour: one at
  // full opacity to preserve the existing colour progression, one at 0
  // opacity so the very bottom of the limb fades to nothing instead of
  // ending in a hard opaque edge — letting the shared .journey-sky (painted
  // behind every section) show through instead of a rectangular cut where
  // this scene's box meets the next one.
  limbStops: { offset: string; color: string; opacity: number }[];
  rimOpacity: number;
  rimWidth: number;
  clouds: Cloud[];
}

const STAGES: Record<Stage, StageConfig> = {
  troposphere: {
    apex: 6,
    dip: 42,
    limbStops: [
      { offset: "0%", color: "#e4f4ff", opacity: 0.65 },
      { offset: "15%", color: "#3fa06f", opacity: 1 },
      { offset: "58%", color: "#1b6f4c", opacity: 1 },
      { offset: "82%", color: "#0d3350", opacity: 1 },
      { offset: "100%", color: "#0d3350", opacity: 0 },
    ],
    rimOpacity: 0.5,
    rimWidth: 1.4,
    clouds: [
      { x: 14, y: 30, sx: 20, sy: 9, opacity: 0.88, shape: "puff", layer: "near" },
      { x: 52, y: 24, sx: 28, sy: 12, opacity: 0.92, shape: "puff", layer: "near" },
      { x: 86, y: 34, sx: 18, sy: 8, opacity: 0.7, shape: "puff", layer: "near" },
      { x: 32, y: 40, sx: 15, sy: 6.5, opacity: 0.55, shape: "wisp", layer: "far" },
      { x: 68, y: 14, sx: 18, sy: 7, opacity: 0.5, shape: "wisp", layer: "far" },
      { x: 2, y: 18, sx: 12, sy: 5, opacity: 0.45, shape: "puff", layer: "far" },
    ],
  },
  stratosphere: {
    apex: 16,
    dip: 54,
    limbStops: [
      { offset: "0%", color: "#a9d4ef", opacity: 0.45 },
      { offset: "25%", color: "#2f6f95", opacity: 1 },
      { offset: "70%", color: "#1b3a55", opacity: 1 },
      { offset: "82%", color: "#0c1e2e", opacity: 1 },
      { offset: "100%", color: "#0c1e2e", opacity: 0 },
    ],
    rimOpacity: 0.75,
    rimWidth: 0.9,
    clouds: [
      { x: 24, y: 24, sx: 26, sy: 3.4, opacity: 0.3, shape: "wisp", layer: "far" },
      { x: 68, y: 16, sx: 20, sy: 2.8, opacity: 0.22, shape: "wisp", layer: "far" },
    ],
  },
  mesosphere: {
    apex: 21,
    dip: 60,
    limbStops: [
      { offset: "0%", color: "#4d7fa8", opacity: 0.4 },
      { offset: "30%", color: "#1b3a55", opacity: 1 },
      { offset: "70%", color: "#123a5e", opacity: 1 },
      { offset: "82%", color: "#05070d", opacity: 1 },
      { offset: "100%", color: "#05070d", opacity: 0 },
    ],
    rimOpacity: 0.95,
    rimWidth: 0.6,
    clouds: [],
  },
};

const config = STAGES[stage];
const limbGradientId = `atmo-limb-${stage}`;
const limbPath = `M0 100 L0 ${config.dip} Q50 ${config.apex} 100 ${config.dip} L100 100 Z`;
const rimPath = `M0 ${config.dip} Q50 ${config.apex} 100 ${config.dip}`;
---

<div class={`atmosphere-layer atmosphere-layer-${stage}`} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <linearGradient id={limbGradientId} x1="0" y1="0" x2="0" y2="1">
        {
          config.limbStops.map((stop) => (
            <stop offset={stop.offset} stop-color={stop.color} stop-opacity={stop.opacity} />
          ))
        }
      </linearGradient>
    </defs>
    <path class="atmo-limb" d={limbPath} fill={`url(#${limbGradientId})`} />
    <path class="atmo-rim-glow" d={rimPath} fill="none" />
    <path class="atmo-rim" d={rimPath} fill="none" opacity={config.rimOpacity} stroke-width={config.rimWidth} />
    <g class="atmo-clouds">
      {
        config.clouds.map((cloud) => (
          <g
            class={`atmo-cloud atmo-cloud-${cloud.layer}`}
            transform={`translate(${cloud.x} ${cloud.y}) scale(${cloud.sx} ${cloud.sy})`}
            opacity={cloud.opacity}
          >
            <path d={cloudBlobs[cloud.shape]} />
          </g>
        ))
      }
    </g>
  </svg>
</div>
