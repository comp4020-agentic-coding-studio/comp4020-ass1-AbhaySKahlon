---
// The Moon rendered as a real NASA photograph rather than illustrated
// craters/maria: Apollo 11's AS11-44-6665, "an outstanding view of the
// entire nearside surface of the moon," photographed during the mission's
// trans-Earth journey home on July 21, 1969 (NASA/JSC, public domain).
// Two sizes so it visibly grows between "moon-approach" and "moon" instead
// of appearing at full size in one step. A circular clipPath keeps the
// photograph itself the sole source of surface detail — no SVG
// craters/maria/noise layered on top — consistent with the photographic
// treatment already used for Earth, the ISS and the animal astronauts.
import moonApollo from "../../assets/scenes/moon-apollo.jpg";

export interface Props {
  size: "approach" | "full";
}

const { size } = Astro.props;
const clipId = `moon-clip-${size}`;
const glowId = `moon-glow-${size}`;
---

<div class={`moon-disc moon-disc-${size}`} aria-hidden="true">
  <svg viewBox="0 0 100 100">
    <defs>
      <clipPath id={clipId}>
        <circle cx="50" cy="50" r="46" />
      </clipPath>
      <radialGradient id={glowId} cx="50%" cy="50%" r="50%">
        <stop offset="80%" stop-color="#f4f4f2" stop-opacity="0" />
        <stop offset="95%" stop-color="#f4f4f2" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#f4f4f2" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g clip-path={`url(#${clipId})`}>
      <image href={moonApollo.src} x="4" y="4" width="92" height="92" preserveAspectRatio="xMidYMid slice" />
    </g>
    <circle cx="50" cy="50" r="49" fill={`url(#${glowId})`} />
  </svg>
</div>
