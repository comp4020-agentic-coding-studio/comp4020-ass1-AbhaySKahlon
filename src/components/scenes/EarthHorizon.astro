---
// The journey's starting environment: the real Earth, photographed from
// Apollo 17 during the translunar coast (AS17-148-22727, "Blue Marble",
// Dec. 7, 1972 — NASA, public domain), shown as a large circular planetary
// disc dominating the lower part of the frame. A clipPath keeps the photo
// itself the sole source of continents/cloud/ocean detail — no hand-drawn
// SVG geography on top — and a thin rim + soft outer glow read as
// atmosphere without turning the photo into an illustration.
import earthBlueMarble from "../../assets/scenes/earth-blue-marble.jpg";
---

<div class="earth-horizon" aria-hidden="true">
  <svg viewBox="0 0 100 100">
    <defs>
      <clipPath id="earth-disc-clip">
        <circle cx="50" cy="50" r="46" />
      </clipPath>
      <radialGradient id="earth-rim-glow" cx="50%" cy="50%" r="50%">
        <stop offset="80%" stop-color="#bfe4ff" stop-opacity="0" />
        <stop offset="95%" stop-color="#cfeaff" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#cfeaff" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g clip-path="url(#earth-disc-clip)">
      <image href={earthBlueMarble.src} x="4" y="4" width="92" height="92" preserveAspectRatio="xMidYMid slice" />
    </g>
    <circle class="earth-rim" cx="50" cy="50" r="46" fill="none" />
    <circle cx="50" cy="50" r="49" fill="url(#earth-rim-glow)" />
  </svg>
</div>
