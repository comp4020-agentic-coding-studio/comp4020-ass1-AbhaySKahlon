---
// The journey's starting environment: a curved horizon rather than a flat
// coloured background, so "Earth" reads as a place, not a gradient stop.
---

<div class="earth-horizon" aria-hidden="true">
  <svg viewBox="0 0 100 60" preserveAspectRatio="none">
    <defs>
      <radialGradient id="earth-glow" cx="50%" cy="0%" r="75%">
        <stop offset="0%" stop-color="#bfe4ff" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#bfe4ff" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect x="0" y="0" width="100" height="60" fill="url(#earth-glow)" />
    <ellipse cx="50" cy="80" rx="75" ry="34" fill="#1b6f4c" />
    <ellipse cx="50" cy="82" rx="75" ry="30" fill="#2f8f63" opacity="0.55" />
    <ellipse cx="30" cy="86" rx="20" ry="10" fill="#14375e" opacity="0.35" />
  </svg>
  <div class="earth-clouds">
    <span></span><span></span><span></span><span></span>
  </div>
</div>
