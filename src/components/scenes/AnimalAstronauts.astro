---
// A real historical photograph stands in for the "animal astronaut" theme:
// Ham, the chimpanzee who flew the Mercury-Redstone 2 suborbital test
// flight on Jan. 31, 1961, photographed shortly after his recovery from the
// Atlantic (NASA/JSC, S63-18198, public domain). Two small fruit flies sit
// further back for depth (the fruit-fly encounter, the actual first animals
// in space), and a scatter of motes give a sense of weightlessness — both
// kept from the previous illustration. The encounter list and its icons
// remain the accessible source of truth; the photo is purely decorative.
import hamChimp from "../../assets/scenes/ham-chimp-post-flight.jpg";

const motes = [
  { x: 150, y: 28, r: 1.6, opacity: 0.5 },
  { x: 172, y: 54, r: 1.2, opacity: 0.4 },
  { x: 104, y: 18, r: 1.4, opacity: 0.45 },
  { x: 186, y: 92, r: 1.8, opacity: 0.5 },
  { x: 64, y: 62, r: 1.2, opacity: 0.35 },
  { x: 132, y: 118, r: 1.6, opacity: 0.4 },
];
---

<div class="animal-astronauts-scene" aria-hidden="true">
  <div class="animal-astronaut-glow"></div>
  <img class="animal-astronaut-photo" src={hamChimp.src} alt="" />
  <svg class="animal-astronauts-overlay" viewBox="0 0 200 140" preserveAspectRatio="xMidYMid meet">
    <g class="fruit-fly" transform="translate(36 28)">
      <ellipse class="fly-wing" cx="-3" cy="-3" rx="5" ry="2.4" transform="rotate(-20 -3 -3)" />
      <ellipse class="fly-wing" cx="3" cy="-3" rx="5" ry="2.4" transform="rotate(20 3 -3)" />
      <ellipse class="fly-body" cx="0" cy="0" rx="3.2" ry="2" />
      <circle class="fly-head" cx="0" cy="-3.4" r="1.3" />
    </g>
    <g class="fruit-fly fruit-fly-far" transform="translate(58 102) scale(0.7)">
      <ellipse class="fly-wing" cx="-3" cy="-3" rx="5" ry="2.4" transform="rotate(-20 -3 -3)" />
      <ellipse class="fly-wing" cx="3" cy="-3" rx="5" ry="2.4" transform="rotate(20 3 -3)" />
      <ellipse class="fly-body" cx="0" cy="0" rx="3.2" ry="2" />
      <circle class="fly-head" cx="0" cy="-3.4" r="1.3" />
    </g>
    {motes.map((m) => <circle class="astro-mote" cx={m.x} cy={m.y} r={m.r} opacity={m.opacity} />)}
  </svg>
</div>
