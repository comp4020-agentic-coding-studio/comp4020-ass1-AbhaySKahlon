---
// A dedicated focal-point scene for the "animal-astronauts" milestone: a
// dog tumbling in a spacesuit (Laika), plus two smaller fruit flies further
// back for depth — recognisable animal anatomy (floppy ears, snout, paws)
// rather than the small line-icon set EncounterField already draws for the
// same encounters. Those icons and the text list remain the accessible
// source of truth; this is purely decorative (aria-hidden), sized to read
// as a scene rather than an enlarged icon.
const motes = [
  { x: 150, y: 28, r: 1.6, opacity: 0.5 },
  { x: 172, y: 54, r: 1.2, opacity: 0.4 },
  { x: 104, y: 18, r: 1.4, opacity: 0.45 },
  { x: 186, y: 92, r: 1.8, opacity: 0.5 },
  { x: 64, y: 62, r: 1.2, opacity: 0.35 },
  { x: 132, y: 118, r: 1.6, opacity: 0.4 },
];
---

<div class="animal-astronauts-scene" aria-hidden="true">
  <svg viewBox="0 0 200 140" preserveAspectRatio="xMidYMid meet">
    <g class="fruit-fly" transform="translate(36 28)">
      <ellipse class="fly-wing" cx="-3" cy="-3" rx="5" ry="2.4" transform="rotate(-20 -3 -3)" />
      <ellipse class="fly-wing" cx="3" cy="-3" rx="5" ry="2.4" transform="rotate(20 3 -3)" />
      <ellipse class="fly-body" cx="0" cy="0" rx="3.2" ry="2" />
      <circle class="fly-head" cx="0" cy="-3.4" r="1.3" />
    </g>
    <g class="fruit-fly fruit-fly-far" transform="translate(58 102) scale(0.7)">
      <ellipse class="fly-wing" cx="-3" cy="-3" rx="5" ry="2.4" transform="rotate(-20 -3 -3)" />
      <ellipse class="fly-wing" cx="3" cy="-3" rx="5" ry="2.4" transform="rotate(20 3 -3)" />
      <ellipse class="fly-body" cx="0" cy="0" rx="3.2" ry="2" />
      <circle class="fly-head" cx="0" cy="-3.4" r="1.3" />
    </g>

    <path
      class="dog-tether"
      d="M 96 36 C 62 54 32 74 6 108 C -3 120 -7 129 -5 138"
      fill="none"
    />
    <ellipse class="dog-tether-clip" cx="96" cy="36" rx="3" ry="2.4" />

    <g class="dog-astronaut-position" transform="translate(120 70) rotate(-14) scale(0.95)">
      <g class="dog-astronaut-drift">
        <path
          class="dog-tail"
          d="M -68 -6 C -78 -14 -80 -26 -74 -34 C -70 -30 -66 -20 -62 -10 C -64 -8 -66 -7 -68 -6 Z"
        />

        <path
          class="dog-leg dog-leg-hind dog-leg-back"
          d="M -34 16 C -36 26 -33 34 -26 37 C -22 32 -23 24 -26 18 Z"
        />
        <ellipse class="dog-paw dog-paw-back" cx="-29" cy="35" rx="4.5" ry="3.5" />
        <path class="dog-leg dog-leg-hind" d="M -46 14 C -50 24 -48 34 -40 38 C -36 34 -36 26 -38 18 Z" />
        <ellipse class="dog-paw" cx="-42" cy="36" rx="5" ry="4" />

        <path
          class="dog-body"
          d="M -60 -8 C -60 -22 -44 -30 -20 -30 C 4 -30 22 -24 30 -12 C 36 -3 34 10 24 16 C 8 24 -20 24 -38 16 C -54 10 -60 2 -60 -8 Z"
        />

        <rect class="dog-pack" x="-46" y="-40" width="30" height="20" rx="6" transform="rotate(-8 -31 -30)" />
        <line class="dog-antenna" x1="-40" y1="-40" x2="-44" y2="-52" />
        <circle class="dog-antenna-tip" cx="-44" cy="-52" r="1.6" />

        <path
          class="dog-leg dog-leg-back"
          d="M 10 16 C 20 26 26 38 26 50 C 22 53 16 52 14 47 C 10 36 4 26 -2 20 Z"
        />
        <ellipse class="dog-paw dog-paw-back" cx="24" cy="50" rx="6" ry="4.5" />
        <path class="dog-leg" d="M 20 10 C 34 16 46 26 50 40 C 46 44 40 44 36 40 C 30 30 22 22 14 18 Z" />
        <ellipse class="dog-paw" cx="50" cy="42" rx="7" ry="5" />

        <ellipse class="dog-collar" cx="34" cy="-16" rx="10" ry="9" />

        <path class="dog-ear dog-ear-back" d="M 30 -38 C 24 -34 22 -24 28 -16 C 34 -18 36 -28 34 -36 Z" />
        <path class="dog-ear" d="M 60 -40 C 68 -46 72 -40 68 -30 C 64 -26 58 -28 56 -34 Z" />

        <circle class="dog-helmet" cx="46" cy="-24" r="22" />
        <ellipse class="dog-snout" cx="64" cy="-18" rx="9" ry="7" />
        <circle class="dog-nose" cx="70" cy="-18" r="2" />
        <ellipse class="dog-visor" cx="49" cy="-26" rx="17" ry="15" />
        <path class="dog-visor-highlight" d="M 38 -34 Q 44 -38 50 -35" fill="none" />
      </g>
    </g>

    {motes.map((m) => <circle class="astro-mote" cx={m.x} cy={m.y} r={m.r} opacity={m.opacity} />)}
  </svg>
</div>
