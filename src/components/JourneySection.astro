---
import type { Milestone } from "../lib/journey";
import EncounterField from "./EncounterField.astro";
import AnimalAstronauts from "./scenes/AnimalAstronauts.astro";
import AtmosphereLayer from "./scenes/AtmosphereLayer.astro";
import DebrisField from "./scenes/DebrisField.astro";
import DeepSpaceField from "./scenes/DeepSpaceField.astro";
import EarthHorizon from "./scenes/EarthHorizon.astro";
import IssStructure from "./scenes/IssStructure.astro";
import KarmanBanner from "./scenes/KarmanBanner.astro";
import KarmanHorizon from "./scenes/KarmanHorizon.astro";
import LunarSurface from "./scenes/LunarSurface.astro";
import MoonDisc from "./scenes/MoonDisc.astro";
import OrbitHorizon from "./scenes/OrbitHorizon.astro";
import SolarWindField from "./scenes/SolarWindField.astro";
import VanAllenField from "./scenes/VanAllenField.astro";

export interface Encounter {
  kind: string;
  label: string;
}

export interface Props {
  milestone: Milestone;
  encounters: Encounter[];
  heightVh: number;
  isFirst: boolean;
}

const { milestone, encounters, heightVh, isFirst } = Astro.props;
const phaseSlug = milestone.phase.toLowerCase().replace(/\s+/g, "-");

// The Moon's own encounters (footprints, hardware) belong on the ground
// drawn by LunarSurface, not scattered across the whole frame.
const encounterBand =
  milestone.id === "moon" ? { left: [15, 85] as [number, number], top: [70, 84] as [number, number] } : undefined;
---

<section
  id={milestone.id}
  class="stop"
  data-phase={phaseSlug}
  data-distance-km={milestone.distanceKm}
  style={`min-height:${heightVh}vh`}
>
  <div class="stop-scene" aria-hidden="true">
    {milestone.id === "earth" && <EarthHorizon />}
    {milestone.id === "troposphere" && <AtmosphereLayer stage="troposphere" />}
    {milestone.id === "stratosphere" && <AtmosphereLayer stage="stratosphere" />}
    {milestone.id === "mesosphere" && <AtmosphereLayer stage="mesosphere" />}
    {milestone.id === "karman-line" && <KarmanHorizon />}
    {milestone.id === "low-earth-orbit" && <OrbitHorizon />}
    {milestone.id === "iss" && <IssStructure />}
    {milestone.id === "animal-astronauts" && <AnimalAstronauts />}
    {milestone.id === "space-debris" && <DebrisField />}
    {milestone.id === "inner-van-allen" && <VanAllenField variant="inner" />}
    {milestone.id === "outer-van-allen" && <VanAllenField variant="outer" />}
    {milestone.id === "solar-wind" && <SolarWindField />}
    {milestone.id === "deep-space" && <DeepSpaceField />}
    {milestone.id === "moon-approach" && <MoonDisc size="approach" />}
    {milestone.id === "moon" && <MoonDisc size="full" />}
    {milestone.id === "moon" && <LunarSurface />}
  </div>
  <EncounterField seed={milestone.id} encounters={encounters} band={encounterBand} />
  {milestone.id === "karman-line" && <KarmanBanner />}
  <div class="stop-content">
    {isFirst && <h1>Deep Space: Earth to Moon</h1>}
    <p class="stop-eyebrow">{milestone.phase} · {milestone.distanceLabel}</p>
    <h2>{milestone.title}</h2>
    <p class="stop-description">{milestone.description}</p>
    {
      encounters.length > 0 && (
        <ul class="stop-encounters" aria-label={`Encountered near ${milestone.title}`}>
          {encounters.map((encounter) => (
            <li data-kind={encounter.kind}>{encounter.label}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>
