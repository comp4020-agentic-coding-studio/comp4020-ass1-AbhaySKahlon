---
import { ICONS } from "../lib/icons";

export interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = ICONS[name] ?? ICONS.dot;
---

<svg
  viewBox={icon.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icon.markup}
/>
